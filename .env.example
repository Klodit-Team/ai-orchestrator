# ── AI Orchestrator (NestJS) ──────────────────────────────────────────────────
PORT=3099
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AI_AGENTS_PATH=../ai-agents/src/agents

# ── MCP server commands (spawned as child processes) ─────────────────────────
MCP_AO_COMMAND=npx
MCP_AO_ARGS=["tsx", "src/index.ts"]
MCP_AO_CWD=../mcp/mcp-ao

MCP_SOUMISSIONS_COMMAND=npx
MCP_SOUMISSIONS_ARGS=["tsx", "src/index.ts"]
MCP_SOUMISSIONS_CWD=../mcp/mcp-soumissions

MCP_DOCUMENTS_COMMAND=npx
MCP_DOCUMENTS_ARGS=["tsx", "src/index.ts"]
MCP_DOCUMENTS_CWD=../mcp/mcp-documents

MCP_STORAGE_COMMAND=npx
MCP_STORAGE_ARGS=["tsx", "src/index.ts"]
MCP_STORAGE_CWD=../mcp/mcp-storage

MCP_DOCUMENT_ANALYSIS_COMMAND=npx
MCP_DOCUMENT_ANALYSIS_ARGS=["tsx", "src/index.ts"]
MCP_DOCUMENT_ANALYSIS_CWD=../mcp/mcp-document-analysis

MCP_NLP_COMMAND=npx
MCP_NLP_ARGS=["tsx", "src/index.ts"]
MCP_NLP_CWD=../mcp/mcp-nlp

MCP_ANOMALY_COMMAND=npx
MCP_ANOMALY_ARGS=["tsx", "src/index.ts"]
MCP_ANOMALY_CWD=../mcp/mcp-anomaly

MCP_EVALUATION_COMMAND=npx
MCP_EVALUATION_ARGS=["tsx", "src/index.ts"]
MCP_EVALUATION_CWD=../mcp/mcp-evaluation

MCP_USERS_COMMAND=npx
MCP_USERS_ARGS=["tsx", "src/index.ts"]
MCP_USERS_CWD=../mcp/mcp-users

MCP_NOTIFICATIONS_COMMAND=npx
MCP_NOTIFICATIONS_ARGS=["tsx", "src/index.ts"]
MCP_NOTIFICATIONS_CWD=../mcp/mcp-notifications

MCP_LLM_COMMAND=npx
MCP_LLM_ARGS=["tsx", "src/index.ts"]
MCP_LLM_CWD=../mcp/mcp-llm

MCP_AUDIT_COMMAND=npx
MCP_AUDIT_ARGS=["tsx", "src/index.ts"]
MCP_AUDIT_CWD=../mcp/mcp-audit

# ── Backend service URLs ───────────────────────────────────────────────────────
AO_BASE_URL=http://localhost:8003/api/v1
AO_SERVICE_TOKEN=local_dev_token
AO_GRE_A_GRE_SCORE_ENDPOINT=/appels-offres/gre-a-gre/{demandeId}/score-ia

SOUMMISSION_BASE_URL=http://localhost:8004
SOUMMISSION_SERVICE_TOKEN=local_dev_token
SOUMMISSION_ANOMALY_ENDPOINT=/api/v1/soumissions/{soumissionId}/anomalies

DOCUMENTS_BASE_URL=http://localhost:8005
DOCUMENTS_SERVICE_TOKEN=local_dev_token
DOCUMENTS_RABBITMQ_URL=amqp://guest:guest@localhost:5672
DOCUMENTS_OCR_RESULTS_QUEUE=documents.ocr.results

EVALUATION_BASE_URL=http://localhost:8008
EVALUATION_SERVICE_TOKEN=local_dev_token
EVALUATION_SCORE_IA_ENDPOINT=/api/v1/evaluations/{evaluationId}/soumissions/{submissionId}/score-ia
EVALUATION_COMPARISON_ENDPOINT=/api/v1/evaluations/{evaluationId}/soumissions/{submissionId}/comparison

USERS_BASE_URL=http://localhost:3002
USERS_SERVICE_TOKEN=local_dev_token

NOTIFICATIONS_BASE_URL=http://localhost:8010/notification-service/v1
NOTIFICATIONS_SERVICE_TOKEN=local_dev_token

AUDIT_BASE_URL=http://localhost:3009
AUDIT_SERVICE_TOKEN=local_dev_token

STORAGE_BASE_URL=http://localhost:4013
STORAGE_TIMEOUT_MS=15000

# ── AI/ML services (unified server on port 4010) ──────────────────────────────
AI_SERVICES_PORT=4010
DOC_ANALYSIS_BASE_URL=http://localhost:4010/ocr
DOC_ANALYSIS_TIMEOUT_MS=25000
NLP_BASE_URL=http://localhost:4010/nlp
NLP_TIMEOUT_MS=25000
ANOMALY_BASE_URL=http://localhost:4010/anomaly
ANOMALY_TIMEOUT_MS=25000

# ── Gemini API (direct REST, no proxy needed) ─────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6KodRNTNwAywA_B0RcZzLS4l1c3YrAzj0z3jCTR_9bdZw
LLM_TIMEOUT_MS=25000
LLM_ONPREM_ENDPOINT=
LLM_EXTERNAL_ENDPOINT=

# ── Anomaly detection threshold ───────────────────────────────────────────────
ANOMALY_ALERT_THRESHOLD=0.85
